# --- Resend (email notifications) ---
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=
# Verified sender address/domain in Resend, e.g. "SAKA Solusindo <inquiry@yourdomain.com>"
RESEND_FROM_EMAIL=
# Where inquiry/lead notifications should be sent
SALES_EMAIL=

# --- AI Sales Assistant (Google Gemini API — free tier, no credit card) ---
# Get your API key from https://aistudio.google.com/app/apikey
# If not set, the assistant will show a graceful fallback message and the rest
# of the site keeps working normally.
AI_API_KEY=

# --- Public site config ---
# Full production URL, used for metadata, OG tags, and sitemap.xml
NEXT_PUBLIC_SITE_URL=https://sakasolution.com
# Shown in footer/contact page as a public contact email (safe to expose)
NEXT_PUBLIC_SALES_EMAIL=info@sakasolution.com
